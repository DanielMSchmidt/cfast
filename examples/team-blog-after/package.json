    "@mui/joy": "^5.0.0-beta.51",
    "@mui/material": "^6.4.0",
    "@react-email/components": "^0.0.36",
    "better-auth": "^1.2.0",
    "drizzle-orm": "^0.44.0",
    "isbot": "^5.1.31",
    "nanoid": "^5.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.12.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.7",
    "@cloudflare/workers-types": "^4.20250620.0",
