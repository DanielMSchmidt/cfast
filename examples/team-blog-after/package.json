{
  "name": "team-blog-after",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "react-router dev",
    "preview": "pnpm run build && vite preview",
    "typecheck": "pnpm run cf-typegen && react-router typegen && tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "test:e2e": "playwright test --project=read-only --project=mutations",
    "test:e2e:ui": "playwright test --ui --project=read-only --project=mutations"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.5.3",
    "@better-auth/passkey": "^1.5.3",
    "@cfast/actions": "workspace:*",
    "@cfast/core": "workspace:*",
    "@cfast/admin": "workspace:*",
    "@cfast/auth": "workspace:*",
    "@cfast/env": "workspace:*",
    "@cfast/db": "workspace:*",
    "@cfast/email": "workspace:*",
    "@cfast/permissions": "workspace:*",
    "@cfast/ui": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/joy": "^5.0.0-beta.51",
    "@mui/material": "^6.4.0",
    "@react-email/components": "^1.0.0",
    "better-auth": "^1.2.0",
    "drizzle-orm": "^0.45.1",
    "isbot": "^5.1.31",
    "nanoid": "^5.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.27.0",
    "@cloudflare/workers-types": "^4.20260310.1",
    "@playwright/test": "^1.58.2",
    "@react-router/dev": "^7.13.1",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "wrangler": "^4.72.0"
  }
}
