{
  "name": "@cfast/storage",
  "version": "0.0.1",
  "description": "Type-safe file uploads to Cloudflare R2 with multipart support and a schema-driven routing API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/client.ts --format esm --dts",
    "dev": "tsup src/index.ts src/client.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4",
    "react": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "jsdom": "^28.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^4.1.0"
  }
}
