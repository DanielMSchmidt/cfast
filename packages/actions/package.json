{
  "name": "@cfast/actions",
  "version": "0.0.2",
  "description": "Multi-action routes and permission-aware action definitions for React Router",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielMSchmidt/cfast.git",
    "directory": "packages/actions"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/client.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "dependencies": {
    "@cfast/db": "workspace:*",
    "@cfast/permissions": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260305.1",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-router": "^7.6.0",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^4.1.0"
  }
}
