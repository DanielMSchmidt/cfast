{
  "name": "@cfast/admin",
  "version": "0.2.3",
  "description": "Auto-generated admin UI from your Drizzle schema with role management and impersonation",
  "keywords": [
    "cfast",
    "cloudflare-workers",
    "admin",
    "drizzle",
    "auto-generated"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielMSchmidt/cfast.git",
    "directory": "packages/admin"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --dts && node ../../scripts/fix-mui-joy-imports.mjs dist",
    "dev": "tsup src/index.ts src/server.ts --format esm --dts --watch --onSuccess \"node ../../scripts/fix-mui-joy-imports.mjs dist\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@cfast/db": ">=0.3.0 <0.5.0",
    "@cfast/forms": ">=0.2.0 <0.4.0",
    "@cfast/joy": ">=0.1.0 <0.3.0",
    "@cfast/permissions": ">=0.3.0 <0.5.0",
    "@cfast/ui": ">=0.2.0 <0.4.0",
    "@mui/joy": ">=5.0.0-beta.0",
    "react": ">=19",
    "react-dom": ">=19",
    "react-router": ">=7",
    "drizzle-orm": ">=0.35"
  },
  "peerDependenciesMeta": {
    "@cfast/db": {
      "optional": false
    },
    "@cfast/forms": {
      "optional": false
    },
    "@cfast/joy": {
      "optional": false
    },
    "@cfast/permissions": {
      "optional": false
    },
    "@cfast/ui": {
      "optional": false
    },
    "@mui/joy": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cfast/db": "workspace:*",
    "@cfast/forms": "workspace:*",
    "@cfast/joy": "workspace:*",
    "@cfast/permissions": "workspace:*",
    "@cfast/ui": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/joy": "^5.0.0-beta.52",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "drizzle-orm": "^0.45.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.12.0",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^4.1.0"
  }
}
