{
  "name": "@cfast/ui",
  "version": "0.0.1",
  "description": "Permission-aware React components with UI library plugins",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./joy": {
      "import": "./dist/joy.js",
      "types": "./dist/joy.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/joy.tsx --format esm --dts",
    "dev": "tsup src/index.ts src/joy.tsx --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@mui/joy": ">=5.0.0-beta.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@mui/joy": {
      "optional": true
    }
  },
  "dependencies": {
    "@cfast/actions": "workspace:*",
    "@cfast/permissions": "workspace:*"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/joy": "^5.0.0-beta.52",
    "@mui/material": "^6.5.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.6.0",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^4.0.18"
  }
}
