{
  "name": "@cfast/ui",
  "version": "0.0.1",
  "description": "Permission-aware React components with UI library plugins",
  "keywords": ["cfast", "cloudflare-workers", "react", "ui", "permissions"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielMSchmidt/cfast.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./joy": {
      "import": "./dist/joy.js",
      "types": "./dist/joy.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "files": ["dist", "llms.txt"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/joy.ts src/client.ts --format esm --dts",
    "dev": "tsup src/index.ts src/joy.ts src/client.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@mui/joy": ">=5.0.0-beta.0",
    "react": ">=19",
    "react-dom": ">=19",
    "react-router": ">=7",
    "sonner": ">=2"
  },
  "peerDependenciesMeta": {
    "@mui/joy": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "dependencies": {
    "@cfast/actions": "workspace:*",
    "@cfast/auth": "workspace:*",
    "@cfast/db": "workspace:*",
    "@cfast/pagination": "workspace:*",
    "@cfast/permissions": "workspace:*",
    "@cfast/storage": "workspace:*"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/joy": "^5.0.0-beta.52",
    "@mui/material": "^6.5.0",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "drizzle-orm": "^0.45.1",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.12.0",
    "sonner": "^2.0.3",
    "storybook": "^8.6.14",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^4.1.0"
  }
}
