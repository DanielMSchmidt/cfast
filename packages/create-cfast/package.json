{
  "name": "create-cfast",
  "version": "0.3.1",
  "description": "Scaffold a fully wired Cloudflare Workers + React Router project with cfast",
  "keywords": [
    "cfast",
    "cloudflare-workers",
    "create",
    "scaffold",
    "react-router"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielMSchmidt/cfast.git",
    "directory": "packages/create-cfast"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "create-cfast": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "kolorist": "^1",
    "prompts": "^2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/prompts": "^2",
    "tsup": "^8",
    "typescript": "^5.7",
    "vite": "^7",
    "vitest": "^3"
  }
}
