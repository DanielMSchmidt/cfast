{
  "name": "@cfast/auth",
  "version": "0.0.1",
  "description": "Authentication for Cloudflare Workers: magic email, passkeys, roles, and impersonation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/client.ts --format esm --dts",
    "dev": "tsup src/index.ts src/client.ts --format esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "peerDependencies": {
    "better-auth": ">=1",
    "drizzle-orm": ">=0.35"
  },
  "dependencies": {
    "@cfast/permissions": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260305.1",
    "drizzle-orm": "^0.44.0",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^4.0.18"
  }
}
