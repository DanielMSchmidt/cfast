{
  "name": "@cfast/db",
  "version": "0.8.1",
  "description": "Permission-aware Drizzle queries for Cloudflare D1",
  "keywords": [
    "cfast",
    "cloudflare-workers",
    "drizzle",
    "d1",
    "permissions",
    "database"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielMSchmidt/cfast.git",
    "directory": "packages/db"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./seed": {
      "import": "./dist/seed.js",
      "types": "./dist/seed.d.ts"
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "sideEffects": [
    "./dist/seed.js",
    "./src/seed.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/seed.ts --format esm --dts",
    "dev": "tsup src/index.ts src/seed.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0"
  },
  "peerDependencies": {
    "@cfast/permissions": ">=0.1.0 <1.0.0",
    "drizzle-orm": ">=0.35"
  },
  "peerDependenciesMeta": {
    "@cfast/permissions": {
      "optional": false
    },
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cfast/permissions": "workspace:*",
    "@cloudflare/workers-types": "^4.20260305.1",
    "drizzle-orm": "^0.45.1",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^4.1.0"
  }
}
