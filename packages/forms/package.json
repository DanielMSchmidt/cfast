{
  "name": "@cfast/forms",
  "version": "0.2.0",
  "description": "Auto-generated forms from Drizzle schema with progressive customization",
  "keywords": [
    "cfast",
    "cloudflare-workers",
    "forms",
    "drizzle",
    "schema-driven"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielMSchmidt/cfast.git",
    "directory": "packages/forms"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./joy": {
      "import": "./dist/joy.js",
      "types": "./dist/joy.d.ts"
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/joy.tsx --format esm --dts && node ../../scripts/fix-mui-joy-imports.mjs dist",
    "dev": "tsup src/index.ts src/joy.tsx --format esm --dts --watch --onSuccess \"node ../../scripts/fix-mui-joy-imports.mjs dist\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@cfast/joy": "workspace:*",
    "@cfast/ui": "workspace:*",
    "@mui/joy": "^5.0.0-beta.48",
    "drizzle-orm": "^0.45.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@cfast/joy": {
      "optional": true
    },
    "@cfast/ui": {
      "optional": true
    },
    "@mui/joy": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cfast/joy": "workspace:*",
    "@cfast/ui": "workspace:*",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@mui/joy": "^5.0.0-beta.48",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-orm": "^0.45.1",
    "jsdom": "^28.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^4.1.0"
  }
}
