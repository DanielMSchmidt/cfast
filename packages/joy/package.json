{
  "name": "@cfast/joy",
  "version": "0.3.0",
  "description": "Joy UI plugin for @cfast/ui — styled components powered by MUI Joy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielMSchmidt/cfast.git",
    "directory": "packages/joy"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts && node ../../scripts/fix-mui-joy-imports.mjs dist",
    "dev": "tsup src/index.ts --format esm --dts --watch --onSuccess \"node ../../scripts/fix-mui-joy-imports.mjs dist\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@cfast/actions": ">=0.1.0 <0.3.0",
    "@cfast/auth": ">=0.3.0 <0.5.0",
    "@cfast/ui": ">=0.2.0 <0.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/joy": ">=5.0.0-beta.0",
    "react": ">=19",
    "react-dom": ">=19",
    "react-router": ">=7"
  },
  "peerDependenciesMeta": {
    "@cfast/actions": {
      "optional": false
    },
    "@cfast/auth": {
      "optional": false
    },
    "@cfast/ui": {
      "optional": false
    },
    "@emotion/react": {
      "optional": false
    },
    "@emotion/styled": {
      "optional": false
    },
    "@mui/joy": {
      "optional": false
    }
  },
  "dependencies": {
    "sonner": "^2.0.3"
  },
  "devDependencies": {
    "@cfast/actions": "workspace:*",
    "@cfast/auth": "workspace:*",
    "@cfast/ui": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/joy": "^5.0.0-beta.52",
    "@mui/material": "^6.5.0",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "drizzle-orm": "^0.45.1",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.12.0",
    "storybook": "^8.6.14",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^4.1.0"
  }
}
