{
  "name": "@cfast/pagination",
  "version": "0.1.0",
  "description": "Cursor-based, offset-based pagination and infinite scroll for React Router",
  "keywords": [
    "cfast",
    "cloudflare-workers",
    "pagination",
    "cursor",
    "infinite-scroll"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielMSchmidt/cfast.git",
    "directory": "packages/pagination"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --dts",
    "dev": "tsup src/index.ts src/server.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "react-router": ">=7"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.6.0",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^4.1.0"
  }
}
